# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (Unit 1) ---
DB_NAME=transactagent
DB_USER=transactagent_app
DB_PASSWORD=changeme

# --- API Service (Unit 2) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme-generate-a-long-random-string
# Comma-separated list of origins allowed to call the API (CORS) -- each MUST exactly
# match an address you'll actually load the frontend from, including port. The
# default covers the host machine itself; add others (e.g. a LAN IP, so phones/other
# devices on your network can reach it too) separated by commas, no spaces:
#   FRONTEND_ORIGIN=http://localhost:8787,http://192.168.1.50:8787
FRONTEND_ORIGIN=http://localhost:8787

# Google OAuth client (create at https://console.cloud.google.com/apis/credentials,
# type "Web application", authorized redirect URI matching GOOGLE_OAUTH_REDIRECT_URI)
GOOGLE_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=changeme
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7878/drive/callback

# --- Ingestion Worker (Unit 3) ---
# GOOGLE_OAUTH_CLIENT_ID/SECRET above are reused here (same OAuth client, needed to
# refresh the Drive access token -- see aidlc-docs/audit.md 2026-08-01).
# GEMINI_API_KEY/GEMINI_MODEL are also used by API Service's Ask AI feature
# (aidlc-docs/audit.md 2026-08-02) -- one key, shared by both services.
GEMINI_API_KEY=changeme
OPENROUTER_API_KEY=changeme
# Model IDs are configuration, not code -- override freely as each provider's lineup
# changes. GEMINI_MODEL must support image input (statement pages are sent as images).
# OPENROUTER_MODEL must be a free-tier model/router if you want to stay on OpenRouter's
# free tier (openrouter/free auto-selects among free-tier models).
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL=openrouter/free
# The categorization LLM client uses the OpenAI SDK pointed at this base_url, so it
# works against any OpenAI-compatible endpoint, not just OpenRouter -- e.g. a local
# model server (LM Studio, omlx-server, mlx_lm.server, etc). To use a local server
# reachable on your Mac's 127.0.0.1, point ingestion-worker (which runs in a container)
# at it via host.docker.internal instead of 127.0.0.1/localhost, and set
# OPENROUTER_API_KEY/OPENROUTER_MODEL above to whatever that server expects.
# Matching Precision Refinement: this is the same setting a local model like
# mlx-community/gemma-4-26b-a4b-it-4bit is pointed at -- since this call is now
# always made (every transaction, not just a fallback, see LLM_CLASSIFICATION_CONCURRENCY
# below), a fast local model here matters more than it used to.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Matching Precision Refinement: the categorization LLM call now runs for every
# transaction in a file, always. Descriptions are grouped into batches of this
# size and classified together in one prompt/response (fewer HTTP round-trips to
# your local model server than one call per transaction); batches themselves run
# concurrently, bounded by LLM_CLASSIFICATION_CONCURRENCY below. Live-tested
# against a real local model: a 10-description batch completes in ~1s.
LLM_CLASSIFICATION_BATCH_SIZE=10
LLM_CLASSIFICATION_CONCURRENCY=5
# Configurable Application Settings: these already existed in config.py but were
# missing here (a real gap, closed by this feature) -- all editable via the Settings
# page's "Application Settings" section going forward, same as every other value in
# this file. Fuzzy-text matching (WR-3/WR-20) and its amount-range gate; the retro-
# active re-scan's auto-apply cutoff (Epic 6); the statement-extraction confidence
# floor; the poll loop interval; LLM/Drive call retry policy; the reporting currency.
SIMILARITY_THRESHOLD=85.0
SIMILARITY_AMOUNT_RATIO_TOLERANCE=4.0
SIMILARITY_AMOUNT_ABSOLUTE_FLOOR=5.0
RECATEGORIZATION_AUTO_APPLY_THRESHOLD=97.0
EXTRACTION_CONFIDENCE_THRESHOLD=medium
POLL_INTERVAL_SECONDS=5.0
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=2.0
REPORTING_CURRENCY=SGD
# Epic 8 (Recurring Payments) tuning -- due-date matching window, trust/tolerance
# auto-apply gate, and detection-scan cadence/pattern criteria.
RECURRING_PAYMENT_MATCH_WINDOW_DAYS=5
RECURRING_PAYMENT_TRUSTED_AMOUNT_RATIO_TOLERANCE=1.15
RECURRING_PAYMENT_TRUSTED_AMOUNT_ABSOLUTE_FLOOR=5.0
RECURRING_PAYMENT_DETECTION_SCAN_INTERVAL_HOURS=24
RECURRING_PAYMENT_DETECTION_MIN_OCCURRENCES=2
RECURRING_PAYMENT_DETECTION_CADENCE_MIN_DAYS=25
RECURRING_PAYMENT_DETECTION_CADENCE_MAX_DAYS=35
# Epic 7 (Nightly Transaction Backup) schedule/retention.
BACKUP_SCHEDULE_HOUR=2
BACKUP_RETENTION_COUNT=7
# The Drive folder to scan for bank statement PDFs -- no default, required.
GOOGLE_DRIVE_FOLDER_ID=changeme
# Epic 7 (Nightly Transaction Backup): a SEPARATE Drive folder from the one above, not
# a subfolder of it, so losing the source folder can't also lose the backups. Required,
# no default. The `backup` subfolder is created under this folder on first use.
GOOGLE_DRIVE_BACKUP_FOLDER_ID=changeme
# Ask AI (Unit 2): caps how many transactions are sent as context per question, most
# recent first -- keeps a very large or "all transactions" question from producing an
# unbounded prompt as your data grows.
AI_ASSISTANT_MAX_TRANSACTIONS=3000
# Configurable Application Settings: these already existed in config.py but were
# missing here (a real gap, closed by this feature) -- all editable via the Settings
# page's "Application Settings" section going forward, same as every other value in
# this file. Session length; result page sizing; CSV export row cap; the due-soon
# lead window for Recurring Payments (Epic 8).
JWT_EXPIRY_MINUTES=1440
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
CSV_EXPORT_MAX_ROWS=50000
RECURRING_PAYMENT_DUE_SOON_LEAD_DAYS=5

# Epic 9 (Local Embedding-Based Semantic Similarity): a SEPARATE local inference server
# from the OPENROUTER_BASE_URL one above -- embeddinggemma-300m is a different model,
# typically a different local server/port than whatever's serving OPENROUTER_BASE_URL's
# text-generation model, even if both happen to be oMLX. No default: this is entirely
# your own host-native setup (not managed by docker-compose), so ingestion-worker treats
# an unset/unreachable value as "no embeddings available" and falls back to the existing
# fuzzy-text matching -- nothing breaks if you never set this.
EMBEDDING_BASE_URL=
# Optional. Leave unset if your server needs no auth. Falls back to
# OPENROUTER_API_KEY if you're pointing EMBEDDING_BASE_URL at the same server as
# OPENROUTER_BASE_URL and that server requires a key.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma-300m
# Cosine similarity threshold (0.0-1.0 scale -- NOT the same scale as the unrelated
# fuzzy-text similarity_threshold, which is 0-100). Raised from 0.75 (Matching
# Precision Refinement) to reject more borderline near-matches.
EMBEDDING_SIMILARITY_THRESHOLD=0.82
EMBEDDING_TOP_K=5
EMBEDDING_BATCH_SIZE=50
# Must match your embedding model's actual output dimensionality.
EMBEDDING_DIMENSIONS=768
# Matching Precision Refinement: the text embedded for a transaction/recurring
# payment now includes a price-range bucket alongside its description/name, e.g.
# "NTUC FAIRPRICE | $1 to $5". Ascending, comma-separated boundaries -- adjust to
# taste; the last value's bucket is open-ended (e.g. "$5000+").
EMBEDDING_PRICE_BUCKET_BOUNDARIES=1,5,10,20,50,100,200,500,1000,2000,5000
# Small score boost (added to the raw 0.0-1.0 cosine score, then capped at 1.0)
# applied when a match candidate's category agrees with the LLM's own
# classification for the transaction being matched -- makes matching a little more
# forgiving when an independent signal corroborates it, without ever penalizing
# disagreement (a mismatch just doesn't get the boost).
EMBEDDING_LLM_AGREEMENT_BOOST=0.05

# --- Frontend (Unit 4) ---
# Optional. Leave unset (recommended) -- the frontend automatically calls the API at
# whatever host you loaded the page from, on port 7878, which correctly handles both
# localhost and LAN-IP access without any configuration. Only set this if the API
# genuinely lives at a different host than the frontend (e.g. a split deployment).
#API_BASE_URL=http://localhost:7878
