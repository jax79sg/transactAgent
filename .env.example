# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (Unit 1) ---
DB_NAME=transactagent
DB_USER=transactagent_app
DB_PASSWORD=changeme

# --- API Service (Unit 2) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme-generate-a-long-random-string
# Comma-separated list of origins allowed to call the API (CORS) -- each MUST exactly
# match an address you'll actually load the frontend from, including port. The
# default covers the host machine itself; add others (e.g. a LAN IP, so phones/other
# devices on your network can reach it too) separated by commas, no spaces:
#   FRONTEND_ORIGIN=http://localhost:8787,http://192.168.1.50:8787
FRONTEND_ORIGIN=http://localhost:8787

# Google OAuth client (create at https://console.cloud.google.com/apis/credentials,
# type "Web application", authorized redirect URI matching GOOGLE_OAUTH_REDIRECT_URI)
GOOGLE_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=changeme
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7878/drive/callback

# --- Ingestion Worker (Unit 3) ---
# GOOGLE_OAUTH_CLIENT_ID/SECRET above are reused here (same OAuth client, needed to
# refresh the Drive access token -- see aidlc-docs/audit.md 2026-08-01).
# GEMINI_API_KEY/GEMINI_MODEL are also used by API Service's Ask AI feature
# (aidlc-docs/audit.md 2026-08-02) -- one key, shared by both services.
GEMINI_API_KEY=changeme
OPENROUTER_API_KEY=changeme
# Model IDs are configuration, not code -- override freely as each provider's lineup
# changes. GEMINI_MODEL must support image input (statement pages are sent as images).
# OPENROUTER_MODEL must be a free-tier model/router if you want to stay on OpenRouter's
# free tier (openrouter/free auto-selects among free-tier models).
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL=openrouter/free
# The categorization LLM client uses the OpenAI SDK pointed at this base_url, so it
# works against any OpenAI-compatible endpoint, not just OpenRouter -- e.g. a local
# model server (LM Studio, omlx-server, mlx_lm.server, etc). To use a local server
# reachable on your Mac's 127.0.0.1, point ingestion-worker (which runs in a container)
# at it via host.docker.internal instead of 127.0.0.1/localhost, and set
# OPENROUTER_API_KEY/OPENROUTER_MODEL above to whatever that server expects.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Defaults to the folder from the original project request; override if different.
GOOGLE_DRIVE_FOLDER_ID=1qeJblYSk-E6BH6dhenbc8Vd0xxRkZor0
# Ask AI (Unit 2): caps how many transactions are sent as context per question, most
# recent first -- keeps a very large or "all transactions" question from producing an
# unbounded prompt as your data grows.
AI_ASSISTANT_MAX_TRANSACTIONS=3000

# --- Frontend (Unit 4) ---
# Optional. Leave unset (recommended) -- the frontend automatically calls the API at
# whatever host you loaded the page from, on port 7878, which correctly handles both
# localhost and LAN-IP access without any configuration. Only set this if the API
# genuinely lives at a different host than the frontend (e.g. a split deployment).
#API_BASE_URL=http://localhost:7878
