# Model Training unit -- host-run only, not part of docker-compose.
# Copy to .env and fill in real values. Never commit the real .env.

# Same Postgres the other 4 units use, reached via the loopback-only host port
# published for this unit (Infrastructure Design) -- DB_PASSWORD must match the
# root .env's value exactly (same database).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=transactagent
DB_USER=
DB_PASSWORD=

# Same oMLX server ingestion-worker's OPENROUTER_* vars point at (root .env) --
# used read-only by evaluate()'s live-model comparison (MTR-7).
OPENROUTER_BASE_URL=http://localhost:8000/v1
OPENROUTER_MODEL=gemma-4-26b-a4b-it-4bit
OPENROUTER_API_KEY=

# ClearML credentials are NOT read through this project's own config (NFR Design) --
# set up via `clearml-init` or CLEARML_API_ACCESS_KEY/CLEARML_API_SECRET_KEY,
# per ClearML's own documentation.
